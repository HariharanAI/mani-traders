# ---------------------------------------------------------------
# MANI TRADERS — environment configuration
# Copy to .env (never commit .env).
# ---------------------------------------------------------------

# Database. Leave empty for local development: an embedded PostgreSQL
# (PGlite) stores data in ./data/pglite. In production set a real
# PostgreSQL connection string.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Public URL of the app (used for links in reset emails / WhatsApp webhooks)
APP_URL=http://localhost:3000

# Session lifetime in hours (sliding expiration)
SESSION_TTL_HOURS=12

# File storage: "local" (./storage) or "s3" (any S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# WhatsApp Business Cloud API (leave empty to use manual WhatsApp sharing only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Token you choose; enter the same value in the Meta webhook configuration
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret, used to verify X-Hub-Signature-256 on webhook calls
WHATSAPP_APP_SECRET=

# Shared secret for the scheduled job endpoint /api/cron/daily
CRON_SECRET=

# Optional SMTP for password reset emails. Without SMTP, reset links are
# printed to the server log and owners can reset employee passwords directly.
SMTP_URL=
SMTP_FROM=

# Backups
BACKUP_DIR=./backups
