# ---------------------------------------------------------------
# MANI TRADERS — environment configuration
# Local development: copy to .env (never commit .env).
# Vercel: set these in Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Database
# Local: leave empty — an embedded PostgreSQL (PGlite) stores data in PGLITE_DIR.
# Vercel: added automatically when you connect a Neon Postgres database
#         (DATABASE_URL or POSTGRES_URL). Use the *pooled* connection string.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Public URL of the app (links in reset emails, WhatsApp webhook URL)
APP_URL=http://localhost:3000

# Session lifetime in hours (sliding expiration)
SESSION_TTL_HOURS=12

# File storage
# Vercel: added automatically when you create a Blob store (Storage → Blob).
BLOB_READ_WRITE_TOKEN=
# Local development fallback
STORAGE_LOCAL_DIR=./storage

# Secret for the daily job (/api/cron/daily). Vercel Cron sends it automatically.
# Generate a long random string.
CRON_SECRET=

# WhatsApp Business Cloud API (optional — manual WhatsApp sharing works without it)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional SMTP for password-reset emails (e.g. smtps://user:pass@smtp.gmail.com:465).
# Without it, the owner resets passwords from Employees.
SMTP_URL=
SMTP_FROM=

# Local backups (not used on Vercel — Neon keeps its own backups)
BACKUP_DIR=./backups
